      },
      "cell": {
        "vars": {
          "res_share": "res_area / (res_area + nres_area)",
          "ntl_res": "ntl * res_share"
        },
        "value": "ntl_res / res_volume",
        "mask": "(res_volume > 0) && ((res_area + nres_area) > 0)"
      },
      "reduce": {
        "method": "ratio_of_sums",
        "numerator": "ntl * (res_area / (res_area + nres_area))",
        "denominator": "res_volume"
      },
      "outputs": [
        {
          "name": "ntl_per_res_vol",
          "units": "ntl/m3"
        }
      ]
