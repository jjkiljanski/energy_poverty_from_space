    {
      "id": "ntl_per_res_vol",
      "group": "Energy consumption proxies",
      "description": "ntl_intensity*(res_area/(res_area+nres_area))/res_volume as ratio of sums.",
      "inputs": [
        "NTL",
        "Surface",
        "Surface_NRES",
        "Volume"
      ],
      "bind": {
        "ntl": "NTL",
        "res_area": "Surface",
